# SignBridge AI — local environment configuration
# Copy this to .env and fill in your paths.
# .env is gitignored and never committed.

# --- CISLR dataset paths ---
# isl_vocab_trimmed.json (written by trim_clips.py --full) is preferred —
# its trimmed_path entries have idle head/tail padding already removed.
# Falls back to isl_vocab_full.json's normalized_path if trimming hasn't
# been run yet.
ISL_VOCAB_PATH=C:\Users\aksha\Desktop\asl project\data\isl_explore\isl_vocab_trimmed.json
ISL_CLIPS_DIR=C:\Users\aksha\Desktop\asl project\data\isl_explore\cislr_normalized

# --- Optional overrides ---
WHISPER_MODEL_SIZE=small

# ASR compute device: cpu (default) or cuda. Set to cuda in the GPU lab or on
# a CUDA laptop — no code change needed.
# ASR_DEVICE=cpu
# Precision. Leave unset to auto-pick (int8 on cpu, float16 on cuda), or set
# explicitly to benchmark, e.g. int8_float16 on cuda.
# ASR_COMPUTE_TYPE=float16

# FFMPEG_BIN=ffmpeg

# Max upload size for /pipeline/run, in MB (default 50). Rejects larger files
# with HTTP 413 before they can fill memory/disk.
# MAX_UPLOAD_MB=50
